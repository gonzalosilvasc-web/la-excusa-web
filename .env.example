# Copie este archivo como ".env" y complete SOLO las claves que vaya a usar.
# NUNCA suba el archivo .env real al repositorio (está excluido en .gitignore).

# Proveedor de extracción OCR/IA multimodal: "openai" o "google".
# Si se deja vacío, se autodetecta según la API key disponible.
OCR_PROVIDER=

# API key de OpenAI (si usa OCR_PROVIDER=openai)
OPENAI_API_KEY=

# API key de Google AI Studio / Gemini (si usa OCR_PROVIDER=google)
GOOGLE_API_KEY=

# Modelo a usar (opcional). Por defecto: gpt-4o (openai) o gemini-1.5-pro (google)
OCR_MODEL=
